{
  "name": "inspirelabs/bluemedia-woocommerce",
  "authors": [
    {
      "name": "iLabs",
      "email": "biuro@inspirelabs.pl"
    }
  ],
  "autoload": {
    "psr-4": {
      "Ilabs\\BM_Woocommerce\\": "src",
      "Isolated\\BlueMedia\\Ilabs\\Ilabs_Plugin\\": "vendor/isolated-ilabs-plugin/ilabs-plugin/src"
    }
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "isolated-ilabs-plugin/ilabs-plugin",
        "version": "1.3.1",
        "dist": {
          "type": "zip",
          "url": "ilabs/setup/isolated_dependencies/isolated-ilabs-plugin-1.3.1.zip"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "isolated-guzzlehttp-guzzle/isolated-guzzle",
        "version": "7.12.3",
        "dist": {
          "type": "zip",
          "url": "ilabs/setup/isolated_dependencies/isolated-guzzle-7.12.3.zip"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "isolated-br33f-php-ga4-mp/isolated-php-ga4-mp",
        "version": "0.1.6",
        "dist": {
          "type": "zip",
          "url": "ilabs/setup/isolated_dependencies/isolated-php-ga4-mp-0.1.6.zip"
        }
      }
    }
  ],
  "require": {
    "isolated-ilabs-plugin/ilabs-plugin": "1.3.1",
    "isolated-guzzlehttp-guzzle/isolated-guzzle": "7.12.3",
    "isolated-br33f-php-ga4-mp/isolated-php-ga4-mp": "0.1.6"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
